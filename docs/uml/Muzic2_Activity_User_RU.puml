@startuml
scale max 900 width
skinparam activityFontSize 9
skinparam shadowing false
title Muzic2 - действия пользователя и администратора

start
:Открыть веб-сервис Muzic2;

if (Кто работает?) then (Пользователь)

  partition Вход {
    if (Уже вошли?) then (нет)
      :Ввести логин и пароль;
      :Нажать «Войти»;
      if (Нет аккаунта?) then (да)
        :Зарегистрироваться;
      endif
      if (Ошибка входа?) then (да)
        :Увидеть сообщение об ошибке;
        stop
      endif
    endif
    :Главная страница и меню\n(Главная, Поиск, Моя музыка);
  }

  repeat
    :Выбрать раздел;

    if (Раздел?) then (Главная)

      partition Главная {
        :Смотреть подборки треков и альбомов;
        :Смотреть список артистов;
        if (Действие?) then (Пульс)
          :Запустить «Пульс»\n(персональный поток);
        elseif (Продолжить слушать)
          :Включить недавно прослушанное;
        elseif (Лайк на карточке)
          :Добавить или убрать\nтрек из любимых;
        elseif (Открыть карточку)
          :Перейти к треку, альбому\nили артисту;
        endif
      }

    elseif (Поиск) then

      partition Поиск {
        :Ввести запрос;
        :Просмотреть найденные\nтреки, альбомы, артистов;
        :Выбрать результат;
      }

    elseif (Моя музыка) then

      partition Моя_музыка {
        :Просмотр любимых треков;
        :Просмотр любимых альбомов;
        :Просмотр своих плейлистов;
        if (Действие?) then (Создать плейлист)
          :Указать название;
          :Выбрать треки;
          :Загрузить обложку\nили авто-обложка;
          :Сохранить;
        elseif (Открыть плейлист)
          :Список треков плейлиста;
          :Включить трек;
        elseif (Удалить плейлист)
          if (Плейлист «Любимые треки»?) then (да)
            :Удаление недоступно;
          else (нет)
            :Подтвердить удаление;
          endif
        elseif (Лайк альбома)
          :Добавить или убрать\nальбом из любимых;
        endif
      }

    elseif (Альбом) then

      partition Альбом {
        :Обложка и список треков;
        :Слушать весь альбом\nили один трек;
        :Добавить альбом в любимые;
      }

    elseif (Артист) then

      partition Артист {
        :Дискография и популярные треки;
        :Перейти на альбом;
        :Слушать треки артиста;
      }

    elseif (Меню трека) then

      partition Контекстное_меню {
        :ПКМ или «три точки» у трека;
        if (Пункт?) then (В любимое)
          :Лайк трека;
        elseif (В плейлист)
          :Добавить в плейлист;
        elseif (Играть)
          :Начать воспроизведение;
        endif
      }

    elseif (Выйти) then
      :Выйти из аккаунта;
      stop

    endif

    partition Прослушивание {
      :Трек в нижнем плеере;
      if (Управление?) then (Пауза)
        :Пауза / продолжить;
      elseif (Следующий)
        :Следующий трек;
      elseif (Предыдущий)
        :Предыдущий трек;
      elseif (Перемотка)
        :Перемотка по времени;
      elseif (Очередь)
        :Открыть очередь,\nвыбрать трек;
      elseif (Текст песни)
        :Синхронный текст\nили караоке;
      elseif (Лайк)
        :Отметить трек сердцем;
      endif
    }

  repeat while (Пользователь в сервисе?) is (да)
  ->нет;

  :Закрыть браузер;
  stop

else (Администратор)

  partition Админ_панель {
    :Открыть админ-панель\n(/public/admin/);
    :Войти под учётной записью\nадминистратора;
    repeat
      :Выбрать вкладку;
      if (Вкладка?) then (Артисты)

        partition Артисты {
          :Просмотр списка артистов;
          :Поиск по имени;
          if (Действие?) then (Добавить)
            :Заполнить имя, обложку, описание;
            :Сохранить артиста;
          elseif (Изменить)
            :Открыть карточку артиста;
            :Изменить данные;
            :Сохранить;
          elseif (Удалить)
            :Подтвердить удаление артиста;
          endif
        }

      elseif (Альбомы) then

        partition Альбомы {
          :Просмотр списка альбомов;
          :Поиск по названию;
          if (Действие?) then (Добавить)
            :Указать альбом, артиста, обложку;
            :Сохранить альбом;
          elseif (Изменить)
            :Изменить название, артиста,\nтип, обложку;
            :Сохранить;
          elseif (Удалить)
            :Подтвердить удаление альбома;
          endif
        }

      else (Треки)

        partition Треки {
          :Просмотр списка треков;
          :Поиск или фильтр по альбому;
          if (Действие?) then (Добавить)
            :Указать название, артиста,\nальбом, файл, обложку;
            :Сохранить трек;
          elseif (Изменить)
            :Изменить поля трека\n(в т.ч. видео, explicit);
            :Сохранить;
          elseif (Удалить)
            :Подтвердить удаление трека;
          endif
        }

      endif
      if (Нужна обложка?) then (да)
        :Загрузить файл обложки;
      endif
    repeat while (Админ в панели?) is (да)
    ->нет;
  }

  :Закрыть админ-панель;
  stop

endif

@enduml
