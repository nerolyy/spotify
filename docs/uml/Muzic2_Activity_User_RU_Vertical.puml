@startuml
scale max 520 width
skinparam activityFontSize 10
skinparam shadowing false
title Muzic2 - действия пользователя (вертикально)

start

:Открыть веб-сервис Muzic2;

partition "1. Вход" {
  if (Вошли?) then (нет)
    :Логин и пароль;
    :Кнопка «Войти»;
    if (Нет аккаунта?) then (да)
      :Регистрация;
    endif
    if (Ошибка?) then (да)
      stop
    endif
  endif
  :Меню: Главная, Поиск, Моя музыка;
}

partition "2. Главная" {
  :Подборки треков и альбомов;
  :Список артистов;
  :«Пульс» — персональный поток;
  :Продолжить слушать;
  :Лайк трека;
  :Открыть трек, альбом, артиста;
}

partition "3. Поиск" {
  :Ввести запрос;
  :Результаты: треки, альбомы, артисты;
  :Выбрать и слушать;
}

partition "4. Моя музыка" {
  :Любимые треки и альбомы;
  :Свои плейлисты;
  :Создать плейлист;
  :Открыть плейлист;
  if (Удалить?) then (да)
    if («Любимые треки»?) then (да)
      :Нельзя удалить;
    else (нет)
      :Удалить;
    endif
  endif
}

partition "5. Альбом и артист" {
  :Страница альбома;
  :Слушать альбом или трек;
  :Страница артиста;
  :Дискография;
}

partition "6. Меню трека" {
  :В любимое;
  :В плейлист;
  :Играть;
}

partition "7. Плеер" {
  :Пауза / продолжить;
  :Следующий / предыдущий;
  :Перемотка;
  :Очередь;
  :Текст и караоке;
  :Лайк;
}

if (Выйти?) then (да)
  stop
endif

:Закрыть браузер;
stop

@enduml
