@startuml
' KOMPAKTNAYA - vmeshivaetsya na 1 stranicu A4
scale max 900 width
skinparam defaultFontSize 10
skinparam usecaseFontSize 10
skinparam actorFontSize 11
skinparam packageStyle rectangle
skinparam shadowing false

title Varianty ispolzovaniya Muzic2 (kratko)

top to bottom direction

actor Guest as Gost
actor User as Polzovatel
actor Admin as Admin

rectangle "Muzic2" {
  usecase UC1 as "Avtorizaciya\n(vhod, registr, vyhod)"
  usecase UC2 as "Glavnaya i katalog"
  usecase UC3 as "Poisk"
  usecase UC4 as "Moya muzyka\n(layki, pleylisty)"
  usecase UC5 as "Albom / artist"
  usecase UC6 as "Pleer\n(ochered, puls, karaoke)"
  usecase UC7 as "Admin-panel\n(CRUD kontent)"
}

Gost --> UC2
Gost --> UC3
Gost --> UC6

Polzovatel --> UC1
Polzovatel --> UC2
Polzovatel --> UC3
Polzovatel --> UC4
Polzovatel --> UC5
Polzovatel --> UC6

Admin --> UC1
Admin --> UC7

UC6 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
UC6 ..> UC2 : <<include>>

@enduml
